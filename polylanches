<title>Poly Lanches</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&display=swap">
<style>
/* Layout: cartão vermelho arredondado com hero em duas colunas (texto + lanche em destaque) e carrossel de lanches embaixo; cardápio branco; faixa de história; rodapé vermelho. */
:root{
  --red:#C8102E;
  --red-deep:#9E0B22;
  --red-soft:#E02A47;
  --white:#FFFFFF;
  --blush:#FFF2F0;
  --line:#F2D2CF;
  --ink:#2B0B10;
  --muted:#6E4A4F;
  --font-display:'DM Serif Display',Georgia,'Times New Roman',serif;
  --font-body:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--white);color:var(--ink);
  font-family:var(--font-body);font-size:16px;line-height:1.55;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:20px 40px;
}
h1,h2,h3,p{margin:0}
h1,h2{font-family:var(--font-display);font-weight:400;text-wrap:balance}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:3px solid #FFB3BE;outline-offset:3px}
.wrap{max-width:1180px;margin-inline:auto}
svg{display:block;max-width:100%}

/* botões */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 24px;border-radius:14px;border:2px solid transparent;font-weight:700;font-size:15px;text-decoration:none;cursor:pointer;transition:transform .15s,background .15s,color .15s}
.btn:hover{transform:translateY(-2px)}
.btn-white{background:var(--white);color:var(--red)}
.btn-ghost{background:transparent;color:var(--white);border-color:rgba(255,255,255,.65)}
.btn-ghost:hover{background:rgba(255,255,255,.14)}
.btn-red{background:var(--red);color:var(--white)}
.btn-red:hover{background:var(--red-deep)}
.btn-outline{background:transparent;color:var(--red);border-color:var(--red)}
.btn-outline:hover{background:var(--red);color:var(--white)}
.btn svg{width:20px;height:20px;flex:none}

/* hero */
.hero{position:relative;overflow:hidden;background:var(--red);color:var(--white);border-radius:32px;padding:clamp(18px,3vw,32px);box-shadow:inset 0 0 0 2px rgba(255,255,255,.35)}
.hero::before{content:"";position:absolute;width:70%;aspect-ratio:1;right:-10%;top:5%;border-radius:50%;background:radial-gradient(closest-side,var(--red-soft),rgba(224,42,71,0));pointer-events:none}
.nav{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:14px}
.logo-mark{width:38px;height:38px;border-radius:50%;background:var(--white);color:var(--red);display:grid;place-items:center;font-family:var(--font-display);font-size:24px;letter-spacing:0;line-height:1}
.nav-links{display:flex;align-items:center;gap:4px}
.nav-links a,.nav-links button{background:none;border:0;color:var(--white);font-size:14px;font-weight:500;padding:10px 14px;border-radius:10px;text-decoration:none;cursor:pointer;min-height:44px}
.nav-links a:hover,.nav-links button:hover{background:rgba(255,255,255,.16)}
.nav-actions{display:flex;align-items:center;gap:8px}
.icon-btn{position:relative;width:46px;height:46px;border-radius:50%;border:2px solid rgba(255,255,255,.6);background:transparent;color:var(--white);display:grid;place-items:center;cursor:pointer}
.icon-btn:hover{background:rgba(255,255,255,.16)}
.icon-btn svg{width:22px;height:22px}
.badge{position:absolute;top:-6px;right:-6px;min-width:22px;height:22px;padding:0 6px;border-radius:11px;background:var(--white);color:var(--red);font-size:12px;font-weight:700;display:grid;place-items:center}
.badge[hidden]{display:none}
.burger-btn{display:none}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:center;padding-block:clamp(20px,4vw,48px) 8px}
.eyebrow{font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;opacity:.9;margin-bottom:14px}
.hero h1{font-size:clamp(42px,6.4vw,78px);line-height:1.02;margin-bottom:18px}
.hero-copy p{max-width:46ch;font-size:17px;opacity:.95;margin-bottom:26px}
.cta-row{display:flex;flex-wrap:wrap;gap:12px}
.stage{min-width:0}
.stage-art{position:relative;width:100%;max-width:480px;margin-inline:auto;aspect-ratio:10/9}
.stage-art svg{width:100%;height:100%;animation:float 5s ease-in-out infinite}
.stage-art.swap svg{animation:pop .45s ease-out,float 5s ease-in-out .45s infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes pop{from{opacity:0;transform:scale(.88) rotate(-4deg)}to{opacity:1;transform:none}}
.stage-caption{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px 14px;margin-top:6px}
.stage-name{font-family:var(--font-display);font-size:24px}
.btn-sm{min-height:40px;padding:0 16px;font-size:14px;border-radius:12px}

/* carrossel */
.carousel{position:relative;z-index:2;display:flex;align-items:center;gap:10px;margin-top:20px}
.arrow{flex:none;width:44px;height:44px;border-radius:50%;border:2px solid rgba(255,255,255,.7);background:transparent;color:var(--white);display:grid;place-items:center;cursor:pointer}
.arrow:hover{background:rgba(255,255,255,.18)}
.arrow svg{width:20px;height:20px}
.thumbs{flex:1;min-width:0;display:flex;gap:12px;overflow-x:auto;padding:16px 6px 10px;scrollbar-width:none;justify-content:center}
.thumbs::-webkit-scrollbar{display:none}
.thumb{position:relative;flex:none;width:104px;padding:8px 8px 6px;border:0;border-radius:16px;background:rgba(0,0,0,.2);color:var(--white);text-align:center;cursor:pointer;transition:transform .2s,background .2s}
.thumb svg{height:58px;width:100%}
.thumb span{display:block;margin-top:2px;font-size:11px;font-weight:700;line-height:1.2}
.thumb:hover{background:rgba(0,0,0,.32)}
.thumb[aria-current="true"]{background:var(--white);color:var(--red);transform:translateY(-6px) scale(1.06)}
.thumb[aria-current="true"]::before{content:"";position:absolute;top:-9px;left:50%;margin-left:-7px;border:7px solid transparent;border-bottom-color:var(--white);border-top:0}
.dots{position:relative;z-index:2;display:flex;justify-content:center;gap:8px;padding-top:2px}
.dot{width:10px;height:10px;border-radius:5px;border:0;background:rgba(255,255,255,.4);padding:0;cursor:pointer;transition:width .2s,background .2s}
.dot[aria-current="true"]{width:28px;background:var(--white)}

/* seções */
section{margin-top:clamp(56px,8vw,96px)}
.section-head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:12px 24px;margin-bottom:28px}
.section-head h2{font-size:clamp(34px,5vw,56px);line-height:1.05;color:var(--red)}
.section-head p{max-width:42ch;color:var(--muted)}
.menu-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:20px}
.card{display:flex;flex-direction:column;background:var(--white);border:1px solid var(--line);border-radius:22px;overflow:hidden}
.card-art{background:var(--blush);padding:14px 18px 6px;aspect-ratio:4/3;display:grid;place-items:center}
.card-art svg{width:100%;height:100%}
.card-art svg circle:first-child{fill:var(--red);opacity:.10}
.card-body{display:flex;flex-direction:column;gap:6px;padding:18px 20px 20px;flex:1}
.card-body h3{font-size:19px;font-weight:700;font-family:var(--font-body)}
.card-body p{color:var(--muted);font-size:14.5px;flex:1}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px}
.in-cart{font-size:13px;font-weight:700;color:var(--red)}

.story{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:28px;align-items:center;background:var(--blush);border-radius:28px;padding:clamp(24px,4vw,48px)}
.story h2{font-size:clamp(34px,5vw,54px);line-height:1.05;color:var(--red);margin-bottom:12px}
.story p{color:var(--muted);max-width:48ch;margin-bottom:22px}
.facts{display:grid;gap:12px}
.fact{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:16px 20px}
.fact small{display:block;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--red)}
.fact strong{font-family:var(--font-display);font-weight:400;font-size:24px}

.contact{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;background:var(--red);color:var(--white);border-radius:28px;padding:clamp(24px,4vw,48px)}
.contact h2{font-size:clamp(32px,5vw,52px);line-height:1.05;margin-bottom:8px}
.contact p{opacity:.95}
.phone{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:14px}
.phone b{font-size:20px;letter-spacing:.02em;user-select:all}
.copy{background:rgba(255,255,255,.18);color:var(--white);border:0;border-radius:10px;min-height:38px;padding:0 14px;font-weight:700;font-size:13px;cursor:pointer}
.copy:hover{background:rgba(255,255,255,.3)}
.foot{margin-top:28px;text-align:center;color:var(--muted);font-size:14px}

/* carrinho */
.fab{position:fixed;z-index:30;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));width:60px;height:60px;border-radius:50%;border:0;background:var(--red);color:var(--white);display:grid;place-items:center;cursor:pointer;box-shadow:0 8px 24px rgba(158,11,34,.45)}
.fab svg{width:26px;height:26px}
.fab .badge{background:var(--white);color:var(--red);box-shadow:0 0 0 2px var(--red)}
.overlay{position:fixed;inset:0;z-index:40;background:rgba(43,11,16,.55);opacity:0;visibility:hidden;transition:opacity .25s,visibility .25s}
.overlay.open{opacity:1;visibility:visible}
.drawer{position:fixed;z-index:50;top:0;bottom:0;right:0;width:min(430px,100%);background:var(--white);color:var(--ink);display:flex;flex-direction:column;gap:14px;transform:translateX(105%);visibility:hidden;transition:transform .3s,visibility .3s;padding:calc(18px + env(safe-area-inset-top,0px)) calc(18px + env(safe-area-inset-right,0px)) calc(18px + env(safe-area-inset-bottom,0px)) 18px;box-shadow:-12px 0 40px rgba(0,0,0,.2)}
.drawer.open{transform:none;visibility:visible}
.drawer-head{display:flex;align-items:center;justify-content:space-between}
.drawer-head h2{font-size:30px;color:var(--red)}
.x{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--white);color:var(--ink);font-size:22px;line-height:1;cursor:pointer}
.x:hover{background:var(--blush)}
.cart-list{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:10px;margin:0;padding:0;list-style:none}
.cart-empty{color:var(--muted);text-align:center;padding:36px 12px;background:var(--blush);border-radius:16px}
.cart-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--line);border-radius:16px}
.cart-item svg{width:56px;height:50px;flex:none;background:var(--blush);border-radius:10px;padding:3px}
.cart-item svg circle:first-child{display:none}
.cart-item b{flex:1;min-width:0;font-size:15px;line-height:1.3}
.step{display:flex;align-items:center;gap:6px}
.step button{width:34px;height:34px;border-radius:50%;border:1px solid var(--red);background:var(--white);color:var(--red);font-size:18px;font-weight:700;line-height:1;cursor:pointer}
.step button:hover{background:var(--red);color:var(--white)}
.step span{min-width:20px;text-align:center;font-weight:700}
.drawer label{font-size:13px;font-weight:700;color:var(--muted)}
.drawer textarea{width:100%;min-height:72px;margin-top:6px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;font:inherit;resize:vertical;background:var(--white);color:var(--ink)}
.drawer-actions{display:grid;gap:10px}
.link-btn{background:none;border:0;color:var(--muted);text-decoration:underline;font-size:14px;cursor:pointer;min-height:36px}

/* história */
.modal{position:fixed;z-index:60;inset:0;display:grid;place-items:center;padding:16px;background:rgba(43,11,16,.62);opacity:0;visibility:hidden;transition:opacity .25s,visibility .25s}
.modal.open{opacity:1;visibility:visible}
.modal-box{position:relative;width:min(540px,100%);max-height:calc(100% - 8px);overflow-y:auto;background:var(--white);border-radius:28px;padding:clamp(24px,5vw,40px);transform:translateY(16px);transition:transform .25s}
.modal.open .modal-box{transform:none}
.modal-box .x{position:absolute;top:14px;right:14px}
.modal-box h2{font-size:clamp(32px,6vw,44px);line-height:1.05;color:var(--red);margin-bottom:14px;padding-right:44px}
.modal-box p{color:var(--muted);margin-bottom:12px}
.modal-box .facts{grid-template-columns:repeat(auto-fit,minmax(130px,1fr));margin:20px 0 22px}
.modal-box .fact{background:var(--blush);border-color:transparent}
.modal-box .fact strong{font-size:20px}

.toast{position:fixed;z-index:70;left:50%;bottom:calc(92px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--ink);color:var(--white);padding:12px 18px;border-radius:12px;font-size:14px;font-weight:500;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:calc(100% - 32px);text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* responsivo */
@media (max-width:860px){
  .nav-links{position:absolute;top:calc(100% + 10px);left:0;right:0;flex-direction:column;align-items:stretch;background:var(--red-deep);border-radius:18px;padding:8px;display:none}
  .nav-links.open{display:flex}
  .nav-links a,.nav-links button{text-align:left}
  .burger-btn{display:grid}
  .hero-grid{grid-template-columns:minmax(0,1fr)}
  .stage-art{max-width:400px}
  .story{grid-template-columns:minmax(0,1fr)}
  .nav-order{display:none}
}
@media (max-width:480px){
  .hero{border-radius:24px}
  .thumb{width:92px}
  .arrow{width:38px;height:38px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>

