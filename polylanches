  <div class="drawer-actions">
    <a class="btn btn-red" id="sendWa" href="#" target="_blank" rel="noopener">Enviar pedido pelo WhatsApp</a>
    <button class="link-btn" type="button" id="clearCart">Limpar pedido</button>
  </div>
</aside>

<div class="modal" id="storyModal" role="dialog" aria-modal="true" aria-labelledby="storyModalTitle" aria-hidden="true">
  <div class="modal-box">
    <button class="x" type="button" id="closeStory" aria-label="Fechar">×</button>
    <h2 id="storyModalTitle">Nossa história</h2>
    <p>A Poly Lanches existe desde 2024. Quem cuida da lanchonete é a Poliana, a dona, que abriu as portas com uma ideia simples.</p>
    <p>Nossa função é te fazer feliz. Cada lanche que sai da nossa cozinha é feito para isso.</p>
    <div class="facts">
      <div class="fact"><small>Desde</small><strong>2024</strong></div>
      <div class="fact"><small>Dona</small><strong>Poliana</strong></div>
      <div class="fact"><small>Missão</small><strong>Te fazer feliz</strong></div>
    </div>
    <a class="btn btn-red" data-wa href="#" target="_blank" rel="noopener">Quero fazer um pedido</a>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
  var WA = '5581993635998';
  function waLink(text){ return 'https://wa.me/' + WA + '?text=' + encodeURIComponent(text); }
  function $(s){ return document.querySelector(s); }
  function $$(s){ return Array.prototype.slice.call(document.querySelectorAll(s)); }

  /* ilustrações originais dos lanches */
  var SUN = '<circle cx="200" cy="190" r="165" fill="#fff" opacity=".10"/>';
  function wrap(label, inner){ return '<svg viewBox="0 0 400 360" role="img" aria-label="' + label + '">' + SUN + inner + '</svg>'; }

  var SVG_BURGER = wrap('Hambúrguer tradicional',
    '<path d="M62 126C62 44 338 44 338 126Z" fill="#E39B34"/>' +
    '<path d="M92 104C108 76 150 64 188 64" fill="none" stroke="#F7C977" stroke-width="9" stroke-linecap="round" opacity=".75"/>' +
    '<g fill="#FFF3D6"><ellipse cx="130" cy="92" rx="10" ry="5.5" transform="rotate(-25 130 92)"/><ellipse cx="180" cy="72" rx="10" ry="5.5" transform="rotate(10 180 72)"/><ellipse cx="232" cy="82" rx="10" ry="5.5" transform="rotate(-15 232 82)"/><ellipse cx="278" cy="100" rx="10" ry="5.5" transform="rotate(30 278 100)"/><ellipse cx="205" cy="108" rx="10" ry="5.5" transform="rotate(5 205 108)"/><ellipse cx="150" cy="114" rx="9" ry="5" transform="rotate(-8 150 114)"/></g>' +
    '<rect x="74" y="138" width="252" height="22" rx="11" fill="#E8364B" stroke="#8F0E22" stroke-width="2"/>' +
    '<path d="M52 176q12.5-24 25 0t25 0 25 0 25 0 25 0 25 0 25 0 25 0 25 0 25 0 25 0 25 0v18H52Z" fill="#7DB840"/>' +
    '<path d="M70 198H330L316 218L298 202L280 232L260 204H140L120 232L102 202L84 218Z" fill="#F6C945"/>' +
    '<rect x="62" y="214" width="276" height="42" rx="21" fill="#5B3020"/>' +
    '<path d="M92 228h56M200 240h84" stroke="#7B4630" stroke-width="5" stroke-linecap="round"/>' +
    '<path d="M66 270H334C334 308 308 330 268 330H132C92 330 66 308 66 270Z" fill="#E39B34"/>');

  var SVG_HOTDOG = wrap('Cachorro-quente',
    '<g transform="rotate(-8 200 190)">' +
    '<rect x="44" y="176" width="312" height="96" rx="48" fill="#D98A2B"/>' +
    '<rect x="30" y="150" width="340" height="58" rx="29" fill="#B5361F"/>' +
    '<path d="M60 162H340" stroke="#D45A3F" stroke-width="8" stroke-linecap="round" opacity=".7"/>' +
    '<path d="M64 182l20-16 20 16 20-16 20 16 20-16 20 16 20-16 20 16 20-16 20 16 20-16 20 16 20-16 20 16" fill="none" stroke="#F6C945" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>' +
    '<path d="M48 198H352C352 252 318 278 276 278H124C82 278 48 252 48 198Z" fill="#EDAB4C"/>' +
    '<path d="M84 222C120 240 160 244 190 244" fill="none" stroke="#F7C977" stroke-width="7" stroke-linecap="round" opacity=".7"/>' +
    '</g>');

  var SVG_COXINHA = wrap('Coxinha',
    '<path d="M200 54C292 130 336 214 296 284C268 334 132 334 104 284C64 214 108 130 200 54Z" fill="#E0962E"/>' +
    '<path d="M148 168C164 134 184 110 198 96" fill="none" stroke="#F4C46E" stroke-width="12" stroke-linecap="round" opacity=".8"/>' +
    '<circle cx="200" cy="52" r="14" fill="#D58625"/>' +
    '<g fill="#B8691A" opacity=".75"><circle cx="170" cy="210" r="4"/><circle cx="226" cy="190" r="4"/><circle cx="250" cy="240" r="4"/><circle cx="196" cy="262" r="4"/><circle cx="144" cy="256" r="4"/><circle cx="212" cy="140" r="3.5"/><circle cx="262" cy="200" r="3.5"/><circle cx="238" cy="282" r="3.5"/><circle cx="166" cy="170" r="3.5"/></g>' +
    '<g fill="#F4C46E" opacity=".8"><circle cx="190" cy="232" r="3.5"/><circle cx="242" cy="214" r="3.5"/><circle cx="154" cy="228" r="3.5"/><circle cx="214" cy="170" r="3.5"/><circle cx="270" cy="256" r="3.5"/></g>');

  var SVG_PASTEL = wrap('Pastel',
    '<g transform="rotate(-10 200 190)">' +
    '<rect x="46" y="112" width="308" height="168" rx="26" fill="#E8A83F"/>' +
    '<rect x="62" y="128" width="276" height="136" rx="16" fill="none" stroke="#B8721C" stroke-width="5" stroke-dasharray="2 9" stroke-linecap="round"/>' +
    '<g fill="#F7CD7A" opacity=".85"><ellipse cx="120" cy="170" rx="24" ry="13"/><ellipse cx="236" cy="152" rx="30" ry="12"/><ellipse cx="290" cy="214" rx="22" ry="12"/><ellipse cx="160" cy="226" rx="26" ry="11"/></g>' +
    '<g fill="#C98622" opacity=".6"><ellipse cx="200" cy="196" rx="20" ry="9"/><ellipse cx="96" cy="222" rx="14" ry="8"/><ellipse cx="312" cy="160" rx="12" ry="7"/></g>' +
    '</g>');

  function bauru(label, filling){
    return wrap(label,
      '<path d="M54 252C54 228 346 228 346 252C346 294 318 310 278 310H122C82 310 54 294 54 252Z" fill="#E39B34"/>' +
      filling +
      '<path d="M64 232H336C336 248 324 256 314 248C308 270 290 270 286 250C278 266 260 266 256 248H132C126 268 110 268 104 250C94 262 78 258 74 246Z" fill="#F6C945"/>' +
      '<g stroke="#4F8F2A" stroke-width="3" stroke-linecap="round"><path d="M110 238l6-3M170 242l6-3M230 240l6-3M290 238l6-3M140 226l6 3M260 228l6 3"/></g>' +
      '<g transform="rotate(-7 200 160)"><path d="M62 200C66 120 336 104 346 166C350 196 332 206 302 206H92C76 206 62 204 62 200Z" fill="#EAA747"/>' +
      '<path d="M120 150l26 22M190 140l26 24M262 144l24 20" stroke="#C57A1C" stroke-width="6" stroke-linecap="round" opacity=".7"/></g>');
  }
  var SVG_BAURU_PIZZA = bauru('Bauru de pizza',
    '<rect x="70" y="214" width="260" height="22" rx="11" fill="#F2A0A8"/>' +
    '<g fill="#E8364B" stroke="#8F0E22" stroke-width="2"><circle cx="112" cy="224" r="17"/><circle cx="172" cy="224" r="17"/><circle cx="232" cy="224" r="17"/><circle cx="292" cy="224" r="17"/></g>');
  var SVG_BAURU_FRANGO = bauru('Bauru de frango',
    '<g fill="#F3D9B1" stroke="#D9B27A" stroke-width="2"><ellipse cx="100" cy="222" rx="30" ry="12" transform="rotate(-8 100 222)"/><ellipse cx="160" cy="218" rx="28" ry="12" transform="rotate(6 160 218)"/><ellipse cx="220" cy="222" rx="30" ry="12" transform="rotate(-5 220 222)"/><ellipse cx="280" cy="218" rx="28" ry="12" transform="rotate(8 280 218)"/></g>' +
    '<g fill="#E8364B" stroke="#8F0E22" stroke-width="2"><circle cx="136" cy="226" r="13"/><circle cx="250" cy="226" r="13"/></g>');

  var ITEMS = [
    {id:'hamburguer', name:'Hambúrguer tradicional', short:'Hambúrguer', desc:'Pão macio, hambúrguer, queijo, alface e tomate.', svg:SVG_BURGER},
    {id:'cachorro', name:'Cachorro-quente', short:'Cachorro-quente', desc:'Pão macio com salsicha e molhos, do jeito clássico.', svg:SVG_HOTDOG},
    {id:'coxinha', name:'Coxinha', short:'Coxinha', desc:'Salgado dourado e crocante por fora, recheado por dentro.', svg:SVG_COXINHA},
    {id:'pastel', name:'Pastel', short:'Pastel', desc:'Massa fininha e crocante, frito na hora.', svg:SVG_PASTEL},
    {id:'bauru-pizza', name:'Bauru de pizza', short:'Bauru de pizza', desc:'Pão com presunto, tomate e queijo derretido, com sabor de pizza.', svg:SVG_BAURU_PIZZA},
    {id:'bauru-frango', name:'Bauru de frango', short:'Bauru de frango', desc:'Pão com frango desfiado, tomate e queijo derretido.', svg:SVG_BAURU_FRANGO}
  ];
  function byId(id){ for (var i=0;i<ITEMS.length;i++) if (ITEMS[i].id===id) return ITEMS[i]; }

  /* ---------- carrinho ---------- */
  var cart = {}; // id -> quantidade
  function total(){ var n=0; for (var k in cart) n += cart[k]; return n; }
  function buildMessage(){
    var ids = Object.keys(cart);
    if (!ids.length) return 'Quero fazer um pedido';
    var msg = 'Quero fazer um pedido:\n';
    ids.forEach(function(id){ msg += '- ' + cart[id] + 'x ' + byId(id).name + '\n'; });
    var obs = ($('#obs').value || '').trim();
    if (obs) msg += 'Observações: ' + obs;
    return msg.replace(/\s+$/,'');
  }
  function renderCart(){
    var list = $('#cartList');
    var ids = Object.keys(cart);
    var n = total();
    $$('[data-count]').forEach(function(b){ b.textContent = n; b.hidden = n === 0; });
    if (!ids.length){
      list.innerHTML = '<li class="cart-empty">Seu pedido está vazio. Escolha um lanche no cardápio para começar.</li>';
    } else {
      list.innerHTML = ids.map(function(id){
        var it = byId(id);
        return '<li class="cart-item">' + it.svg + '<b>' + it.name + '</b>' +
          '<div class="step"><button type="button" data-dec="' + id + '" aria-label="Diminuir ' + it.name + '">−</button>' +
          '<span>' + cart[id] + '</span>' +
          '<button type="button" data-inc="' + id + '" aria-label="Aumentar ' + it.name + '">+</button></div></li>';
      }).join('');
    }
    ITEMS.forEach(function(it){
      var el = document.getElementById('in-' + it.id);
      if (el) el.textContent = cart[it.id] ? (cart[it.id] + (cart[it.id] === 1 ? ' no pedido' : ' no pedido')) : '';
    });
    $('#sendWa').href = waLink(buildMessage());
  }
  var toastTimer;
  function toast(text){
    var t = $('#toast'); t.textContent = text; t.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 1800);
  }
  function add(id){ cart[id] = (cart[id] || 0) + 1; renderCart(); toast(byId(id).name + ' adicionado ao pedido'); }
  $('#cartList').addEventListener('click', function(e){
    var b = e.target.closest('button'); if (!b) return;
    var inc = b.getAttribute('data-inc'), dec = b.getAttribute('data-dec');
    if (inc) cart[inc]++;
    if (dec){ cart[dec]--; if (cart[dec] <= 0) delete cart[dec]; }
    renderCart();
  });
  $('#obs').addEventListener('input', renderCart);
  $('#clearCart').addEventListener('click', function(){ cart = {}; renderCart(); });

  /* ---------- painéis (carrinho e história) ---------- */
  var lastFocus = null;
  function openCart(){
    lastFocus = document.activeElement;
    $('#overlay').classList.add('open'); $('#drawer').classList.add('open'); $('#drawer').setAttribute('aria-hidden','false');
    $('#closeCart').focus();
  }
  function closeCart(){
    $('#overlay').classList.remove('open'); $('#drawer').classList.remove('open'); $('#drawer').setAttribute('aria-hidden','true');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function openStory(){
    lastFocus = document.activeElement;
    $('#storyModal').classList.add('open'); $('#storyModal').setAttribute('aria-hidden','false');
    $('#closeStory').focus();
  }
  function closeStory(){
    $('#storyModal').classList.remove('open'); $('#storyModal').setAttribute('aria-hidden','true');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  $('#fab').addEventListener('click', openCart);
  $('#navCart').addEventListener('click', openCart);
  $('#closeCart').addEventListener('click', closeCart);
  $('#overlay').addEventListener('click', closeCart);
  $$('[data-open-story]').forEach(function(b){ b.addEventListener('click', function(){ $('#navLinks').classList.remove('open'); openStory(); }); });
  $('#closeStory').addEventListener('click', closeStory);
  $('#storyModal').addEventListener('click', function(e){ if (e.target === this) closeStory(); });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape'){
      if ($('#storyModal').classList.contains('open')) closeStory();
      else if ($('#drawer').classList.contains('open')) closeCart();
    }
  });

  /* menu móvel */
  $('#burgerBtn').addEventListener('click', function(){
    var open = $('#navLinks').classList.toggle('open');
    this.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  $$('#navLinks a').forEach(function(a){ a.addEventListener('click', function(){ $('#navLinks').classList.remove('open'); }); });

  /* ---------- WhatsApp ---------- */
  $$('[data-wa]').forEach(function(a){ a.href = waLink('Quero fazer um pedido'); });

  /* ---------- hero interativo ---------- */
  var current = 0;
  function renderHero(i, animate){
    current = (i + ITEMS.length) % ITEMS.length;
    var it = ITEMS[current];
    var art = $('#stageArt');
    art.innerHTML = it.svg;
    if (animate){ art.classList.remove('swap'); void art.offsetWidth; art.classList.add('swap'); }
    $('#stageName').textContent = it.name;
    $$('.thumb').forEach(function(t, k){ t.setAttribute('aria-current', k === current ? 'true' : 'false'); });
    $$('.dot').forEach(function(d, k){ d.setAttribute('aria-current', k === current ? 'true' : 'false'); });
    var sel = $$('.thumb')[current];
    var box = $('#thumbs');
    if (sel && box){ box.scrollTo({left: sel.offsetLeft - (box.clientWidth - sel.offsetWidth) / 2, behavior:'smooth'}); }
  }
  $('#thumbs').innerHTML = ITEMS.map(function(it, k){
    return '<button class="thumb" type="button" data-i="' + k + '" aria-label="' + it.name + '">' + it.svg + '<span>' + it.short + '</span></button>';
  }).join('');
  $('#dots').innerHTML = ITEMS.map(function(it, k){
    return '<button class="dot" type="button" data-i="' + k + '" aria-label="Ver ' + it.name + '"></button>';
  }).join('');
  $('#thumbs').addEventListener('click', function(e){ var b = e.target.closest('.thumb'); if (b) renderHero(+b.getAttribute('data-i'), true); });
  $('#dots').addEventListener('click', function(e){ var b = e.target.closest('.dot'); if (b) renderHero(+b.getAttribute('data-i'), true); });
  $('#prev').addEventListener('click', function(){ renderHero(current - 1, true); });
  $('#next').addEventListener('click', function(){ renderHero(current + 1, true); });
  $('#stageAdd').addEventListener('click', function(){ add(ITEMS[current].id); });

  /* ---------- cardápio ---------- */
  $('#menuGrid').innerHTML = ITEMS.map(function(it){
    return '<article class="card"><div class="card-art">' + it.svg + '</div>' +
      '<div class="card-body"><h3>' + it.name + '</h3><p>' + it.desc + '</p>' +
      '<div class="card-foot"><button class="btn btn-outline btn-sm" type="button" data-add="' + it.id + '">+ Adicionar</button>' +
      '<span class="in-cart" id="in-' + it.id + '"></span></div></div></article>';
  }).join('');
  $('#menuGrid').addEventListener('click', function(e){
    var b = e.target.closest('[data-add]'); if (b) add(b.getAttribute('data-add'));
  });

  /* ---------- copiar número ---------- */
  $('#copyPhone').addEventListener('click', function(){
    var btn = this, txt = $('#phoneText').textContent;
    function done(){ btn.textContent = 'Número copiado'; setTimeout(function(){ btn.textContent = 'Copiar número'; }, 1800); }
    function fallback(){
      var r = document.createRange(); r.selectNodeContents($('#phoneText'));
      var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
      btn.textContent = 'Selecionado, copie o número'; setTimeout(function(){ btn.textContent = 'Copiar número'; }, 2200);
    }
    try {
      navigator.clipboard.writeText(txt).then(done, fallback);
    } catch (err) { fallback(); }
  });

  renderHero(0, false);
  renderCart();
})();
</script>

</body></html>
